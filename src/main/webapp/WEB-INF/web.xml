<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>SahanaMart E-Commerce Platform</display-name>

    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Application Lifecycle Listener -->
    <listener>
        <listener-class>com.sahana.sahanamart.listener.AppContextListener</listener-class>
    </listener>

    <!-- Filters -->
    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.sahana.sahanamart.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>com.sahana.sahanamart.filter.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.sahana.sahanamart.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/buyer/*</url-pattern>
        <url-pattern>/seller/*</url-pattern>
        <url-pattern>/admin/*</url-pattern>
        <url-pattern>/cart/*</url-pattern>
        <url-pattern>/checkout/*</url-pattern>
        <url-pattern>/reviews/add</url-pattern>
    </filter-mapping>

    <!-- Servlets -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
        <url-pattern>/register</url-pattern>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>BuyerServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.BuyerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BuyerServlet</servlet-name>
        <url-pattern>/products</url-pattern>
        <url-pattern>/product/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CartServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.CartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
        <url-pattern>/cart/add</url-pattern>
        <url-pattern>/cart/update</url-pattern>
        <url-pattern>/cart/remove</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CheckoutServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.CheckoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CheckoutServlet</servlet-name>
        <url-pattern>/checkout</url-pattern>
        <url-pattern>/order-confirmation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>OrderServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.OrderServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>OrderServlet</servlet-name>
        <url-pattern>/buyer/orders</url-pattern>
        <url-pattern>/seller/orders</url-pattern>
        <url-pattern>/seller/orders/update-status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ReviewServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.ReviewServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ReviewServlet</servlet-name>
        <url-pattern>/reviews/add</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>SellerServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.SellerServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SellerServlet</servlet-name>
        <url-pattern>/seller/dashboard</url-pattern>
        <url-pattern>/seller/products/create</url-pattern>
        <url-pattern>/seller/products/edit</url-pattern>
        <url-pattern>/seller/products/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
        <url-pattern>/admin/products/toggle-status</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>HealthServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.api.HealthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>HealthServlet</servlet-name>
        <url-pattern>/api/v1/health</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProductApiServlet</servlet-name>
        <servlet-class>com.sahana.sahanamart.controller.api.ProductApiServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProductApiServlet</servlet-name>
        <url-pattern>/api/v1/products</url-pattern>
        <url-pattern>/api/v1/products/*</url-pattern>
    </servlet-mapping>

    <!-- 30-minute explicit session timeout per Week 1 spec -->
    <session-config>
        <session-timeout>30</session-timeout>
        <cookie-config>
            <http-only>true</http-only>
            <secure>false</secure>
        </cookie-config>
        <tracking-mode>COOKIE</tracking-mode>
    </session-config>

    <!-- Custom error pages avoiding any stack trace exposure per Week 7 security spec -->
    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

    <error-page>
        <exception-type>java.lang.Throwable</exception-type>
        <location>/WEB-INF/views/error/500.jsp</location>
    </error-page>

</web-app>
